# Browser URL: http://localhost:${PORT}
PORT=8000

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep this stable across restarts. Changing it logs everyone out and, unless a
# separate encryption key is configured, makes saved secrets unreadable.
JWT_SECRET_KEY=

# Optional separate Fernet key for provider/CAPTCHA and authenticator secrets. Set
# before saving secrets and keep it stable. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# Set to 1 when the app is served over HTTPS. Local plain HTTP requires 0.
JWT_COOKIE_SECURE=0

# Optional email delivery for MFA and future transactional messages.
# Provider: smtp, ses, aliyun, resend, or none (explicitly disabled).
# Blank preserves legacy SMTP_HOST/SMTP_FROM deployments.
EMAIL_PROVIDER=
# Single sender, optionally with a display name. SMTP_FROM is the SMTP fallback.
# Aliyun display names must be at most 15 characters; a bare address also works.
EMAIL_FROM=

# TLS is required: starttls (usually 587) or ssl (usually 465).
SMTP_HOST=
# Blank selects 587 for starttls or 465 for ssl.
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# AWS SES v2. Use a verified sender in this region and an identity with ses:SendEmail.
# Blank keys allow the AWS SDK credential chain (for example an IAM role).
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Aliyun DirectMail API. Sender must be configured in the selected region.
# Regions: cn-hangzhou, ap-southeast-1, eu-central-1, us-east-1.
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SECURITY_TOKEN=

# Resend API. Use a sending API key and a verified sender domain.
RESEND_API_KEY=

# Optional first-run bootstrap. If blank, create the first administrator in the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Self-registration is enabled by default. Administrators can also change this
# and all CAPTCHA settings from the panel Settings screen.
REGISTRATION_ENABLED=1

# Optional CAPTCHA bootstrap. Provider: none, turnstile, recaptcha, or hcaptcha.
# Site keys are public; secret keys are encrypted if later saved through the UI.
CAPTCHA_PROVIDER=none
CAPTCHA_HOSTNAME=
CAPTCHA_ON_LOGIN=1
CAPTCHA_ON_REGISTER=1
CAPTCHA_ON_UPLOAD=1
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Optional SQLAlchemy URL. Blank uses SQLite at /app/data/app.db.
# PostgreSQL: postgresql://user:password@host/database
# MariaDB:   mariadb://user:password@host/database?charset=utf8mb4
DATABASE_URL=

# Compose starts a private Redis cache. Blank disables caching. For a local
# non-Docker app, leave blank or point at your own Redis (localhost, not redis).
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60
# Use a distinct prefix for independent installations sharing Redis.
REDIS_KEY_PREFIX=subtitle-translator

# Debug mode exposes the offline Echo provider in the web UI. Keep disabled normally.
FLASK_DEBUG=0

# Number of files translated concurrently. Each file can use several API workers.
JOB_WORKERS=2
MAX_UPLOAD_MB=200

# Optional bootstrap values. You can enter keys from the web Settings screen instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPL_API_KEY=
GOOGLE_API_KEY=
